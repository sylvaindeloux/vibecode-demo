{#
 # PageHeader - the page <h1>, an optional subtitle and an optional actions zone.
 # <twig:PageHeader title="Clients">
 #     <twig:block name="actions"><twig:Button variant="primary" …>…</twig:Button></twig:block>
 # </twig:PageHeader>
 #}
{% props title, subtitle = null %}
<header {{ attributes.defaults({class: 'page-header'}) }}>
    <div class="page-header__text">
        <h1 class="page-header__title">{{ title }}</h1>
        {% if subtitle %}<p class="page-header__subtitle">{{ subtitle }}</p>{% endif %}
    </div>
    {% if block('actions') is defined %}
        <div class="page-header__actions">{{ block('actions') }}</div>
    {% endif %}
</header>
