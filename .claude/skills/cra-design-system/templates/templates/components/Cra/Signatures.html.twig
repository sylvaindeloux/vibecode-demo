{#
 # Cra:Signatures - two signature zones (freelance, client). Never split across pages.
 #}
{% props freelancerName, clientName %}
<section class="cra-signatures" aria-label="{{ 'cra.signatures.label'|trans }}">
    {% for party in [{role: 'cra.signatures.freelancer'|trans, name: freelancerName}, {role: 'cra.signatures.client'|trans, name: clientName}] %}
        <div class="cra-signature">
            <p class="cra-signature__role">{{ party.role }}</p>
            <p>{{ party.name }}</p>
            <div class="cra-signature__box" role="img" aria-label="{{ 'cra.signatures.box'|trans }}"></div>
            <p class="cra-signature__hint">{{ 'cra.signatures.hint'|trans }}</p>
        </div>
    {% endfor %}
</section>
