{#
 # Cra:Toolbar - screen-only bar above the sheet: back link, document name, print button.
 #}
{% props backUrl, title %}
<div class="cra-toolbar" data-print-hide>
    <twig:Button variant="ghost" icon="lucide:arrow-left" :href="backUrl">Retour au calendrier</twig:Button>
    <p class="cra-toolbar__title">{{ title }}</p>
    <twig:PrintButton />
</div>
