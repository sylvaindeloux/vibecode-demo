{#
 # Calendar:Day - one gridcell. `day` = CalendarDay view model:
 #   {date: 'Y-m-d', number, kind: workday|weekend|holiday|outside, state: empty|full|half|off,
 #    note, isToday, holidayName, label: 'lundi 14 septembre 2026'}
 # Exactly one day of the grid is `tabbable` (roving tabindex).
 #}
{% props day, tabbable = false %}
{%- if day.kind == 'outside' -%}
    <td role="gridcell" class="calendar-day" data-kind="outside" data-state="empty" aria-disabled="true">
        <span class="calendar-day__button" aria-hidden="true"><span class="calendar-day__number">{{ day.number }}</span></span>
    </td>
{%- else -%}
    {%- set label = day.label
        ~ (day.kind == 'holiday' ? ', ' ~ 'calendar.kind.holiday'|trans ~ ' : ' ~ day.holidayName : '')
        ~ (day.kind == 'weekend' ? ', ' ~ 'calendar.kind.weekend'|trans : '')
        ~ (day.isToday ? ', ' ~ 'calendar.today'|trans : '') -%}
    {%- set accessibleName = label ~ ', ' ~ ('calendar.state.' ~ day.state)|trans ~ (day.note ? ', ' ~ 'calendar.note'|trans ~ ' : ' ~ day.note : '') -%}
    <td role="gridcell" {{ attributes.defaults({class: 'calendar-day'}) }}
        data-calendar-target="day"
        data-date="{{ day.date }}"
        data-kind="{{ day.kind }}"
        data-state="{{ day.state }}"
        data-label="{{ label }}"
        data-note="{{ day.note }}"
        {%- if day.holidayName %} data-holiday-name="{{ day.holidayName }}"{% endif %}
        {%- if day.note %} data-has-note{% endif %}
        {%- if day.isToday %} data-today aria-current="date"{% endif %}>
        <button type="button" class="calendar-day__button" tabindex="{{ tabbable ? 0 : -1 }}"
            aria-label="{{ accessibleName }}"
            data-action="click->calendar#cycle keydown->calendar#keydown focus->calendar#focus">
            <span class="calendar-day__number" aria-hidden="true">{{ day.number }}</span>
            <span class="calendar-day__label" aria-hidden="true"><twig:Calendar:DayLabel :state="day.state" :kind="day.kind" :holidayName="day.holidayName" /></span>
            <span class="calendar-day__note" aria-hidden="true"><twig:ux:icon name="lucide:sticky-note" class="icon" /></span>
        </button>
    </td>
{%- endif -%}
