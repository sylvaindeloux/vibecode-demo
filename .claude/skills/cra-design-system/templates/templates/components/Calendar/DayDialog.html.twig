{#
 # Calendar:DayDialog - edit one day: state (segmented control) + note (shown on the CRA).
 # Opened by the calendar controller (key N, or the "Edit day" button of Calendar:Selection).
 #}
<twig:Modal id="calendar-day-dialog" icon="lucide:notebook-pen" :title="'calendar.dialog.title'|trans" data-calendar-target="dialog">
    <p class="text-muted" data-calendar-target="dialogDate"></p>
    <form id="calendar-day-form" class="stack" data-action="submit->calendar#saveDialog">
        <twig:SegmentedControl
            name="day-state"
            :legend="'calendar.dialog.state'|trans"
            :options="[
                {value: 'full', label: 'calendar.state.full'|trans, icon: 'lucide:check'},
                {value: 'half', label: 'calendar.state.half'|trans},
                {value: 'off', label: 'calendar.state.off'|trans, icon: 'lucide:tree-palm'},
                {value: 'empty', label: 'calendar.state.empty'|trans},
            ]"
        />
        <twig:Field id="calendar-day-note" :label="'calendar.dialog.note'|trans" :help="'calendar.dialog.note_help'|trans" optional>
            <twig:Textarea id="calendar-day-note" name="note" maxlength="140" rows="2" describedBy="calendar-day-note_help" data-calendar-target="dialogNote" />
        </twig:Field>
    </form>
    <twig:block name="footer">
        <twig:Button data-action="modal#close">{{ 'action.cancel'|trans }}</twig:Button>
        <twig:Button type="submit" variant="primary" form="calendar-day-form" icon="lucide:check">{{ 'action.save'|trans }}</twig:Button>
    </twig:block>
</twig:Modal>
