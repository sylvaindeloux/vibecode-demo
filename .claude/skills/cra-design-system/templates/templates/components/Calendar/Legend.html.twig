{# Calendar:Legend - explains every day appearance (shape + color + text). #}
<ul class="calendar-legend" aria-label="{{ 'calendar.legend.label'|trans }}">
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-state="full"></span>{{ 'calendar.state.full'|trans }}</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-state="half"></span>{{ 'calendar.state.half'|trans }}</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-state="off"></span>{{ 'calendar.state.off'|trans }}</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-kind="holiday"></span>{{ 'calendar.kind.holiday'|trans|capitalize }}</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-kind="weekend"></span>{{ 'calendar.kind.weekend'|trans|capitalize }}</li>
</ul>
