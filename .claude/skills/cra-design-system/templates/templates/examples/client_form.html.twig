{#
 # Reference screen 3c - Client create/edit form. Routes: app_client_new, app_client_edit
 # Controller variables:
 #   form    ClientType form view (name, address, contactName, contactEmail, mission)
 #   client  null when creating
 # Validation errors are rendered by the form theme (templates/form/theme.html.twig).
 #}
{% extends 'base.html.twig' %}

{% set title = client ? 'client.form.edit_title'|trans({name: client.name}) : 'client.form.new_title'|trans %}

{% block title %}{{ title }} · {{ 'app.name'|trans }}{% endblock %}
{% block page_modifier %} page--narrow{% endblock %}

{% block body %}
    <twig:PageHeader :title="title" :subtitle="'client.form.subtitle'|trans" />

    <twig:Card>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.address) }}
            <div class="form__row">
                {{ form_row(form.contactName) }}
                {{ form_row(form.contactEmail) }}
            </div>
            {{ form_row(form.mission) }}
            <div class="form-actions">
                <twig:Button type="submit" variant="primary" icon="lucide:check">{{ 'action.save'|trans }}</twig:Button>
                <twig:Button variant="ghost" :href="path('app_client_index')">{{ 'action.cancel'|trans }}</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
