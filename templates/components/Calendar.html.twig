{#
 # Calendar - monthly work calendar (key component). Spec: references/calendar.md
 #
 # Props
 #   month      CalendarMonth view model (see references/calendar.md#view-model)
 #   saveUrl    endpoint receiving {"days":[{date,state,note}]} (POST, JSON). null = no persistence.
 #   csrfToken  token sent in the X-CSRF-Token header
 #   printUrl   URL of the printable CRA for this month/client (summary CTA)
 #   readonly   true when the month cannot be edited (no client selected, month locked)
 #   clientId   kept in the month selector query string
 #
 # Stimulus: calendar_controller.js (keyboard grid, states, day dialog, quick actions, summary).
 #}
{% props month, saveUrl = null, csrfToken = null, printUrl = null, readonly = false, clientId = null %}
{# Texts used by the controller; `states` also names the state in the accessible name of each day. #}
{%- set labels = {
    states: {empty: 'Non travaillé', full: 'Journée complète', half: 'Demi-journée', off: 'Congé ou absence'},
    unit: {one: 'jour travaillé', other: 'jours travaillés'},
    note: 'Note',
    total: 'Total',
    daysUpdated: 'Jours mis à jour',
    saveError: 'Enregistrement impossible',
    saveErrorHint: 'Vos dernières modifications ont été annulées. Vérifiez votre connexion et réessayez.',
} -%}
{%- set weekdays = [
    {long: 'lundi', short: 'Lun', initial: 'L'},
    {long: 'mardi', short: 'Mar', initial: 'M'},
    {long: 'mercredi', short: 'Mer', initial: 'M'},
    {long: 'jeudi', short: 'Jeu', initial: 'J'},
    {long: 'vendredi', short: 'Ven', initial: 'V'},
    {long: 'samedi', short: 'Sam', initial: 'S'},
    {long: 'dimanche', short: 'Dim', initial: 'D'},
] -%}
<section {{ attributes.defaults({
    class: 'calendar',
    'aria-labelledby': 'calendar-title',
    'data-controller': 'calendar',
    'data-calendar-url-value': saveUrl ?? '',
    'data-calendar-csrf-token-value': csrfToken ?? '',
    'data-calendar-readonly-value': readonly ? 'true' : 'false',
    'data-calendar-labels-value': labels|json_encode,
}) }}{% if readonly %} data-readonly{% endif %}>

    <twig:Calendar:Toolbar :month="month" :readonly="readonly" :clientId="clientId" />

    <p id="calendar-instructions" class="visually-hidden">Grille du mois. Flèches pour changer de jour, Entrée pour cocher, N pour ajouter une note. Liste des raccourcis sous le calendrier.</p>

    <table class="calendar__grid" role="grid" aria-labelledby="calendar-title" aria-describedby="calendar-instructions"{% if readonly %} aria-readonly="true"{% endif %}>
        <thead>
            <tr role="row">
                {% for weekday in weekdays %}
                    <th role="columnheader" scope="col" class="calendar__weekday">
                        <abbr title="{{ weekday.long }}">
                            <span class="calendar__weekday-long">{{ weekday.short }}</span>
                            <span class="calendar__weekday-short">{{ weekday.initial }}</span>
                        </abbr>
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for week in month.weeks %}
                <tr role="row">
                    {% for day in week %}
                        <twig:Calendar:Day :day="day" :stateLabel="labels.states[day.state]" :tabbable="day.date == month.focusDate" />
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if not readonly %}<twig:Calendar:Selection />{% endif %}

    <div class="visually-hidden" role="status" aria-live="polite" data-calendar-target="status"></div>

    <twig:Calendar:Legend />

    <details class="calendar__help" data-print-hide>
        <summary>Raccourcis clavier</summary>
        <dl>
            <dt><kbd>←</kbd> <kbd>→</kbd> <kbd>↑</kbd> <kbd>↓</kbd></dt><dd>Changer de jour</dd>
            <dt><kbd>Entrée</kbd> / <kbd>Espace</kbd></dt><dd>Journée → demi-journée → non travaillé</dd>
            <dt><kbd>J</kbd> <kbd>D</kbd> <kbd>C</kbd></dt><dd>Journée complète, demi-journée, congé</dd>
            <dt><kbd>Suppr</kbd></dt><dd>Non travaillé</dd>
            <dt><kbd>N</kbd></dt><dd>Modifier le jour (type et note)</dd>
            <dt><kbd>Début</kbd> / <kbd>Fin</kbd></dt><dd>Début ou fin de semaine (Ctrl : du mois)</dd>
            <dt><kbd>Page préc.</kbd> / <kbd>Page suiv.</kbd></dt><dd>Mois précédent ou suivant</dd>
        </dl>
    </details>

    <twig:Calendar:Summary :month="month" :printUrl="printUrl" />

    {# Visible day labels, cloned by the controller when a state changes. #}
    {% for key in ['full', 'half', 'off', 'kind-holiday', 'kind-workday', 'kind-weekend'] %}
        <template data-calendar-target="labelTemplate" data-key="{{ key }}">
            {%- if key starts with 'kind-' -%}
                <twig:Calendar:DayLabel state="empty" :kind="key|slice(5)" holidayName="" />
            {%- else -%}
                <twig:Calendar:DayLabel :state="key" kind="workday" />
            {%- endif -%}
        </template>
    {% endfor %}

    {% if not readonly %}
        <twig:Calendar:DayDialog />
        <twig:Modal id="calendar-clear-confirm" variant="danger" icon="lucide:eraser" title="Vider le mois ?">
            <p>Tous les jours cochés et toutes les notes de {{ month.label }} seront effacés.</p>
            <twig:block name="footer">
                <twig:Button data-action="modal#close" data-modal-target="initialFocus">Annuler</twig:Button>
                <twig:Button variant="danger" icon="lucide:eraser" data-action="calendar#clearMonth modal#close">Vider le mois</twig:Button>
            </twig:block>
        </twig:Modal>
    {% endif %}
</section>
