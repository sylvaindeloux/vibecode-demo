{#
 # Cra:Party - one party block of the CRA (freelance or client).
 # party: {name, company?, siret?, address?, contactName?, contactEmail?, email?}
 # siret: 14 digits, printed in groups of 3, 3, 3 and 5 digits.
 #}
{% props role, party %}
<section class="cra-party" aria-label="{{ role }}">
    <p class="cra-party__role">{{ role }}</p>
    <p class="cra-party__name">{{ party.name }}</p>
    {% if party.company ?? null %}<p>{{ party.company }}</p>{% endif %}
    {% if party.address ?? null %}<address>{{ party.address }}</address>{% endif %}
    {% if party.siret ?? null %}<p>SIRET <span class="cra-party__id">{{ party.siret|slice(0, 9)|split('', 3)|join(' ') }} {{ party.siret|slice(9) }}</span></p>{% endif %}
    {% if party.contactName ?? null %}<p>Contact : {{ party.contactName }}{% if party.contactEmail ?? null %} · {{ party.contactEmail }}{% endif %}</p>{% endif %}
    {% if party.email ?? null %}<p>{{ party.email }}</p>{% endif %}
</section>
