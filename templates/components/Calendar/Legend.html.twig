{# Calendar:Legend - explains every day appearance (shape + color + text). #}
<ul class="calendar-legend" aria-label="Légende">
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-state="full"></span>Journée complète</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-state="half"></span>Demi-journée</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-state="off"></span>Congé ou absence</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-kind="holiday"></span>Jour férié</li>
    <li class="calendar-legend__item"><span class="calendar-legend__swatch" data-kind="weekend"></span>Week-end</li>
</ul>
