{#
 # AppHeader - app name, main navigation (bottom tab bar on mobile), theme switch.
 # Active item: compared with the current route name prefix.
 #}
{% props theme = 'system' %}
{%- set route = app.current_route ?? '' -%}
<header {{ attributes.defaults({class: 'app-header'}) }}>
    <div class="app-header__inner">
        <a class="app-header__brand" href="{{ path('app_calendar') }}">
            <span class="app-header__logo" aria-hidden="true"><twig:ux:icon name="lucide:calendar-check" class="icon" /></span>
            EasyCRA
        </a>
        <nav class="app-nav" aria-label="Navigation principale">
            <ul class="app-nav__list">
                <li><twig:NavLink :href="path('app_calendar')" icon="lucide:calendar-days" label="Calendrier" :active="route starts with 'app_calendar' or route starts with 'app_cra'" /></li>
                <li><twig:NavLink :href="path('app_client_index')" icon="lucide:users" label="Clients" :active="route starts with 'app_client'" /></li>
                <li><twig:NavLink :href="path('app_profile')" icon="lucide:user-round" label="Profil" :active="route starts with 'app_profile'" /></li>
            </ul>
        </nav>
        <div class="app-header__end">
            <twig:ThemeSwitch :current="theme" />
        </div>
    </div>
</header>
