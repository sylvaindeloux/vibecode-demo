{
    "name": "sylvaindeloux/easycra",
    "description": "EasyCRA: the monthly activity report (CRA) of a French freelancer, printed to PDF by the browser.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.5",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-icons": "^3.5",
        "symfony/ux-turbo": "^3.5",
        "symfony/ux-twig-component": "^3.5",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.29",
        "twig/intl-extra": "^3.30"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": [
            "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
            "@php bin/console cache:warmup --env=dev",
            "@php vendor/bin/phpstan analyse",
            "@php bin/console lint:twig templates",
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config"
        ],
        "fix": [
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "test": [
            "@php bin/phpunit"
        ],
        "check": [
            "@lint",
            "@test",
            "@php .claude/skills/cra-design-system/scripts/check-styles.php",
            "@php bin/console doctrine:schema:validate",
            "@php bin/console debug:translation fr --only-missing --domain=messages || [ $? -eq 64 ]"
        ],
        "reset": [
            "@php bin/console doctrine:database:drop --force --if-exists",
            "@php bin/console doctrine:schema:create",
            "@php bin/console doctrine:fixtures:load --no-interaction"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "scripts-descriptions": {
        "lint": "Runs PHP-CS-Fixer (dry run), PHPStan and the Symfony linters.",
        "fix": "Applies PHP-CS-Fixer.",
        "test": "Runs the PHPUnit test suite.",
        "check": "Runs every check required before a commit.",
        "reset": "Drops the dev database, creates the schema and loads the demo data."
    }
}
